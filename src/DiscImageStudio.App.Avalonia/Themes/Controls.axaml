<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:DiscImageStudio.App.Avalonia.Controls">
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource DiscBackgroundBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource DiscFontFamily}" />
    <Setter Property="Foreground" Value="{DynamicResource DiscTextBrush}" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource DiscTextBrush}" />
  </Style>

  <!--
    Fluent's Button template paints its own pointer-over/pressed/disabled brushes directly on
    PART_ContentPresenter, which hides every Background/Foreground set by the classes below and
    skips their transitions. Design-system buttons keep the presenter bound to the Button so the
    class styles (and their BrushTransitions) stay the single source of truth for each state.
  -->
  <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter,
                   Button.secondary /template/ ContentPresenter#PART_ContentPresenter,
                   Button.ghost /template/ ContentPresenter#PART_ContentPresenter,
                   Button.navigation-item /template/ ContentPresenter#PART_ContentPresenter,
                   Button.stage-item /template/ ContentPresenter#PART_ContentPresenter,
                   Button.media-template /template/ ContentPresenter#PART_ContentPresenter,
                   Button.new-project-family /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
    <Setter Property="BorderBrush" Value="{Binding $parent[Button].BorderBrush}" />
    <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
  </Style>

  <Style Selector="Button.primary:disabled, Button.secondary:disabled, Button.ghost:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource DiscAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource DiscOnAccentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource DiscRadiusField}" />
    <Setter Property="Height" Value="{DynamicResource DiscControlHeight}" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.18" Easing="SineEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.primary:pointerover, Button.primary:pressed">
    <Setter Property="Background" Value="{DynamicResource DiscAccentHoverBrush}" />
  </Style>

  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="{DynamicResource DiscSurfaceRaisedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource DiscTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DiscBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource DiscRadiusField}" />
    <Setter Property="Height" Value="{DynamicResource DiscControlHeight}" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.18" Easing="SineEaseOut" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.18" Easing="SineEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.secondary:pointerover, Button.secondary:pressed">
    <Setter Property="Background" Value="{DynamicResource DiscAccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DiscAccentBrush}" />
  </Style>

  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource DiscTextBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource DiscRadiusField}" />
    <Setter Property="Height" Value="{DynamicResource DiscControlHeight}" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.18" Easing="SineEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.ghost:pointerover, Button.ghost:pressed">
    <Setter Property="Background" Value="{DynamicResource DiscAccentSoftBrush}" />
  </Style>

  <Style Selector="Button.sidebar-toggle">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="Path.sidebar-toggle-icon">
    <Setter Property="Stroke" Value="{DynamicResource DiscTextBrush}" />
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
  </Style>

  <Style Selector="Button.sidebar-toggle Path.sidebar-toggle-collapse">
    <Setter Property="IsVisible" Value="True" />
  </Style>

  <Style Selector="Button.sidebar-toggle Path.sidebar-toggle-expand">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <Style Selector="Button.sidebar-toggle.collapsed Path.sidebar-toggle-collapse">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <Style Selector="Button.sidebar-toggle.collapsed Path.sidebar-toggle-expand">
    <Setter Property="IsVisible" Value="True" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource DiscSurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DiscBorderBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource DiscRadiusField}" />
    <Setter Property="Foreground" Value="{DynamicResource DiscTextBrush}" />
    <Setter Property="Height" Value="{DynamicResource DiscControlHeight}" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="controls:RevealOnOpen.IsEnabled" Value="True" />
    <Setter Property="CornerRadius" Value="{DynamicResource DiscRadiusField}" />
  </Style>

  <Style Selector="Expander">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="controls:RevealOnOpen.IsEnabled" Value="True" />
    <Setter Property="CornerRadius" Value="{DynamicResource DiscRadiusCard}" />
  </Style>

  <!-- Shell chrome intentionally leaves the window frame to the Linux desktop. -->
  <Style Selector="Border.shell-header">
    <Setter Property="Background" Value="{DynamicResource DiscSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DiscBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="{DynamicResource DiscHeaderPadding}" />
    <!-- Keeps the header from jumping when the compact layout hides the subtitle. -->
    <Setter Property="MinHeight" Value="72" />
  </Style>

  <Style Selector="Border.shell-sidebar">
    <Setter Property="Background" Value="{DynamicResource DiscSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DiscBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
    <Setter Property="Padding" Value="12" />
  </Style>

  <Style Selector="TextBlock.sidebar-label">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.16" Easing="SineEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.navigation-item">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource DiscRadiusField}" />
    <Setter Property="Height" Value="42" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,2" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.14" Easing="SineEaseOut" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.14" Easing="SineEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Grid.navigation-content">
    <Setter Property="ClipToBounds" Value="False" />
  </Style>

  <Style Selector="Button.navigation-item:pointerover">
    <Setter Property="Background" Value="{DynamicResource DiscSurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <Style Selector="Button.navigation-item.current">
    <Setter Property="Background" Value="{DynamicResource DiscAccentSoftBrush}" />
  </Style>

  <Style Selector="Button.navigation-item.current:pointerover">
    <Setter Property="Background" Value="{DynamicResource DiscAccentSoftBrush}" />
  </Style>

  <Style Selector="Border.navigation-selection">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="40" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource DiscRadiusField}" />
  </Style>

  <Style Selector="Border.shell-sidebar.sidebar-collapsed Button.navigation-item:pointerover">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Border.shell-sidebar.sidebar-collapsed Button.navigation-item.current">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Border.shell-sidebar.sidebar-collapsed Button.navigation-item:pointerover Border.navigation-selection">
    <Setter Property="Background" Value="{DynamicResource DiscSurfaceRaisedBrush}" />
  </Style>

  <Style Selector="Border.shell-sidebar.sidebar-collapsed Button.navigation-item.current Border.navigation-selection">
    <Setter Property="Background" Value="{DynamicResource DiscAccentSoftBrush}" />
  </Style>

  <Style Selector="Border.shell-sidebar.sidebar-collapsed Button.navigation-item:focus Border.navigation-selection">
    <Setter Property="BorderBrush" Value="{DynamicResource DiscAccentBrush}" />
  </Style>

  <Style Selector="Viewbox.navigation-icon">
    <Setter Property="Height" Value="20" />
    <Setter Property="Width" Value="20" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Path.navigation-stroke">
    <Setter Property="Stroke" Value="{DynamicResource DiscTextMutedBrush}" />
    <Setter Property="StrokeThickness" Value="1.8" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Stroke" Duration="0:0:0.18" Easing="SineEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Ellipse.navigation-stroke">
    <Setter Property="Stroke" Value="{DynamicResource DiscTextMutedBrush}" />
    <Setter Property="StrokeThickness" Value="1.8" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Stroke" Duration="0:0:0.18" Easing="SineEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.navigation-item.current Path.navigation-stroke">
    <Setter Property="Stroke" Value="{DynamicResource DiscAccentBrush}" />
  </Style>

  <Style Selector="Button.navigation-item:pointerover Path.navigation-stroke">
    <Setter Property="Stroke" Value="{DynamicResource DiscAccentBrush}" />
  </Style>

  <Style Selector="Button.navigation-item.current Ellipse.navigation-stroke">
    <Setter Property="Stroke" Value="{DynamicResource DiscAccentBrush}" />
  </Style>

  <Style Selector="Button.navigation-item:pointerover Ellipse.navigation-stroke">
    <Setter Property="Stroke" Value="{DynamicResource DiscAccentBrush}" />
  </Style>

  <Style Selector="TextBlock.navigation-label">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextAlignment" Value="Left" />
  </Style>

  <Style Selector="Button.navigation-item:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource DiscAccentBrush}" />
  </Style>

  <Style Selector="Border.stage-bar">
    <Setter Property="Background" Value="{DynamicResource DiscSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DiscBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource DiscRadiusCard}" />
    <Setter Property="Padding" Value="6" />
  </Style>

  <Style Selector="Button.stage-item">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource DiscRadiusField}" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Foreground" Value="{DynamicResource DiscTextMutedBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.18" Easing="SineEaseOut" />
        <BrushTransition Property="Foreground" Duration="0:0:0.18" Easing="SineEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.stage-item:pointerover">
    <Setter Property="Background" Value="{DynamicResource DiscSurfaceRaisedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource DiscTextBrush}" />
  </Style>

  <Style Selector="Button.stage-item.current">
    <Setter Property="Background" Value="{DynamicResource DiscAccentSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource DiscAccentBrush}" />
  </Style>

  <Style Selector="Button.stage-item:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource DiscAccentBrush}" />
  </Style>

  <Style Selector="TextBlock.stage-shortcut">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource DiscTextMutedBrush}" />
  </Style>

  <Style Selector="Border.navigation-notice">
    <Setter Property="Background" Value="{DynamicResource DiscAccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DiscAccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource DiscRadiusField}" />
    <Setter Property="Padding" Value="12,10" />
  </Style>

  <Style Selector="Border.project-toolbar">
    <Setter Property="Background" Value="{DynamicResource DiscSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DiscBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource DiscRadiusCard}" />
    <Setter Property="Padding" Value="14,10" />
  </Style>

  <Style Selector="Border.project-dirty-badge">
    <Setter Property="Background" Value="{DynamicResource DiscAccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DiscAccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource DiscRadiusChip}" />
    <Setter Property="Padding" Value="7,2" />
  </Style>

  <Style Selector="Border.project-dirty-badge TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource DiscAccentBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.project-file-path, TextBlock.project-action-status">
    <Setter Property="Foreground" Value="{DynamicResource DiscTextMutedBrush}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="Border.project-action-error">
    <Setter Property="Background" Value="#22D95757" />
    <Setter Property="BorderBrush" Value="#99D95757" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource DiscRadiusField}" />
    <Setter Property="Padding" Value="12,10" />
  </Style>

  <!-- Composition preview: a square stage whose neutral fill shows where the canvas is transparent. -->
  <Style Selector="Border.composition-stage">
    <Setter Property="Width" Value="440" />
    <Setter Property="Height" Value="440" />
    <Setter Property="CornerRadius" Value="{DynamicResource DiscRadiusCard}" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="Background" Value="{DynamicResource DiscSurfaceRaisedBrush}" />
  </Style>

  <Style Selector="Ellipse.composition-ring">
    <Setter Property="Stroke" Value="{DynamicResource DiscAccentBrush}" />
    <Setter Property="StrokeThickness" Value="0.8" />
    <Setter Property="StrokeDashArray" Value="4,3" />
    <Setter Property="Opacity" Value="0.85" />
  </Style>

  <Style Selector="Border.composition-busy">
    <Setter Property="Background" Value="{DynamicResource DiscOverlayBrush}" />
  </Style>

  <Style Selector="Border.composition-busy TextBlock">
    <Setter Property="Foreground" Value="White" />
  </Style>

  <Style Selector="Button.history-action">
    <Setter Property="Width" Value="30" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="Path.history-icon">
    <Setter Property="Stroke" Value="{DynamicResource DiscTextBrush}" />
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
  </Style>

  <Style Selector="Button.project-missing-assets">
    <Setter Property="Height" Value="22" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CornerRadius" Value="{DynamicResource DiscRadiusChip}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource DiscWarningBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource DiscWarningBrush}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.project-missing-assets /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
    <Setter Property="BorderBrush" Value="{Binding $parent[Button].BorderBrush}" />
    <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
  </Style>

  <Style Selector="Button.project-missing-assets:pointerover">
    <Setter Property="Background" Value="{DynamicResource DiscAccentSoftBrush}" />
  </Style>

  <Style Selector="Border.project-settings-dialog">
    <Setter Property="MaxWidth" Value="820" />
    <Setter Property="MaxHeight" Value="780" />
  </Style>

  <Style Selector="TextBlock.settings-section-title">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.settings-field-label">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.settings-hint, TextBlock.settings-path">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource DiscTextMutedBrush}" />
  </Style>

  <Style Selector="Border.settings-readonly-chip">
    <Setter Property="Background" Value="{DynamicResource DiscSurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DiscBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource DiscRadiusField}" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>

  <Style Selector="Border.settings-asset-summary">
    <Setter Property="Background" Value="{DynamicResource DiscSurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DiscBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource DiscRadiusField}" />
    <Setter Property="Padding" Value="12,9" />
  </Style>

  <Style Selector="Border.settings-asset-summary.missing">
    <Setter Property="BorderBrush" Value="{DynamicResource DiscWarningBrush}" />
  </Style>

  <Style Selector="Border.settings-review">
    <Setter Property="Background" Value="{DynamicResource DiscAccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DiscAccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource DiscRadiusField}" />
    <Setter Property="Padding" Value="14,12" />
  </Style>

  <Style Selector="TextBlock.settings-match">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource DiscSuccessBrush}" />
  </Style>

  <Style Selector="TextBlock.settings-match.attention">
    <Setter Property="Foreground" Value="{DynamicResource DiscWarningBrush}" />
  </Style>

  <Style Selector="Border.settings-asset-row">
    <Setter Property="Background" Value="{DynamicResource DiscSurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DiscBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource DiscRadiusField}" />
    <Setter Property="Padding" Value="12,9" />
  </Style>

  <Style Selector="Ellipse.settings-asset-dot">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="Fill" Value="{DynamicResource DiscSuccessBrush}" />
  </Style>

  <Style Selector="Border.settings-asset-row.missing Ellipse.settings-asset-dot">
    <Setter Property="Fill" Value="{DynamicResource DiscWarningBrush}" />
  </Style>

  <Style Selector="TextBlock.settings-asset-status">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource DiscSuccessBrush}" />
  </Style>

  <Style Selector="Border.settings-asset-row.missing TextBlock.settings-asset-status">
    <Setter Property="Foreground" Value="{DynamicResource DiscWarningBrush}" />
  </Style>

  <Style Selector="Border.job-dock">
    <Setter Property="Background" Value="{DynamicResource DiscSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DiscBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>

  <Style Selector="Border.job-dock-item">
    <Setter Property="BorderBrush" Value="{DynamicResource DiscBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="16,10" />
  </Style>

  <Style Selector="TextBlock.job-detail">
    <Setter Property="Foreground" Value="{DynamicResource DiscTextMutedBrush}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="Button.compact-action">
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="ItemsControl.toast-host">
    <Setter Property="Width" Value="360" />
  </Style>

  <Style Selector="Border.toast-card">
    <Setter Property="Background" Value="{DynamicResource DiscSurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DiscBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource DiscRadiusFloating}" />
    <Setter Property="BoxShadow" Value="0 8 24 0 #33000000" />
    <Setter Property="Padding" Value="14,12,8,12" />
  </Style>

  <Style Selector="TextBlock.toast-message">
    <Setter Property="Foreground" Value="{DynamicResource DiscTextMutedBrush}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- Dialog close button: top-aligned with the title, muted until hovered. -->
  <Style Selector="Button.dialog-close">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>

  <Style Selector="Path.dialog-close-icon">
    <Setter Property="Stroke" Value="{DynamicResource DiscTextMutedBrush}" />
    <Setter Property="StrokeThickness" Value="2.2" />
    <Setter Property="StrokeLineCap" Value="Round" />
  </Style>

  <Style Selector="Button.dialog-close:pointerover Path.dialog-close-icon">
    <Setter Property="Stroke" Value="{DynamicResource DiscTextBrush}" />
  </Style>

  <Style Selector="Button.toast-dismiss">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="19" />
  </Style>

  <Style Selector="Border.modal-scrim">
    <Setter Property="Background" Value="{DynamicResource DiscOverlayBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="24" />
  </Style>

  <Style Selector="Border.modal-card">
    <Setter Property="Background" Value="{DynamicResource DiscSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DiscBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BoxShadow" Value="0 16 48 0 #66000000" />
    <Setter Property="CornerRadius" Value="{DynamicResource DiscRadiusCard}" />
    <Setter Property="Padding" Value="24" />
    <Setter Property="Width" Value="460" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.modal-message">
    <Setter Property="Foreground" Value="{DynamicResource DiscTextMutedBrush}" />
  </Style>

  <Style Selector="TextBlock.sidebar-caption">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource DiscTextMutedBrush}" />
  </Style>

  <Style Selector="controls|PageHeader">
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource DiscSpace4}">
          <StackPanel Spacing="{DynamicResource DiscSpace2}">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource DiscSpace2}">
              <TextBlock Text="{TemplateBinding Title}" FontSize="30" FontWeight="SemiBold" />
              <Border IsVisible="{TemplateBinding IsBadgeVisible}"
                      Background="{DynamicResource DiscAccentSoftBrush}"
                      CornerRadius="{DynamicResource DiscRadiusChip}"
                      Padding="8,3"
                      VerticalAlignment="Center">
                <TextBlock Text="{TemplateBinding Badge}"
                           Foreground="{DynamicResource DiscAccentBrush}"
                           FontSize="12"
                           FontWeight="SemiBold" />
              </Border>
            </StackPanel>
            <TextBlock Text="{TemplateBinding Subtitle}"
                       Foreground="{DynamicResource DiscTextMutedBrush}"
                       FontSize="15"
                       TextWrapping="Wrap" />
          </StackPanel>
          <ContentPresenter Grid.Column="1"
                            Content="{TemplateBinding Actions}"
                            VerticalAlignment="Center" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="controls|SectionCard">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{DynamicResource DiscSurfaceBrush}"
                BorderBrush="{DynamicResource DiscBorderBrush}"
                BorderThickness="1"
                BoxShadow="0 4 16 0 #1A000000"
                CornerRadius="{DynamicResource DiscRadiusCard}"
                Padding="{DynamicResource DiscCardPadding}">
          <StackPanel Spacing="{DynamicResource DiscSpace4}">
            <StackPanel Spacing="{DynamicResource DiscSpace1}">
              <TextBlock Text="{TemplateBinding Title}" FontSize="17" FontWeight="SemiBold" />
              <TextBlock Text="{TemplateBinding Description}"
                         Foreground="{DynamicResource DiscTextMutedBrush}"
                         FontSize="13"
                         TextWrapping="Wrap" />
            </StackPanel>
            <ContentPresenter Content="{TemplateBinding Content}" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="controls|SourceChip">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{DynamicResource DiscSurfaceRaisedBrush}"
                BorderBrush="{DynamicResource DiscBorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource DiscRadiusField}"
                Padding="12,9">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource DiscSpace3}">
            <StackPanel Spacing="2">
              <TextBlock Text="{TemplateBinding Text}" FontWeight="SemiBold" />
              <TextBlock Text="{TemplateBinding Detail}"
                         Foreground="{DynamicResource DiscTextMutedBrush}"
                         FontSize="12"
                         TextWrapping="Wrap" />
            </StackPanel>
            <ContentPresenter Grid.Column="1"
                              Content="{TemplateBinding Actions}"
                              VerticalAlignment="Center" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="controls|PathField">
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Spacing="{DynamicResource DiscSpace2}">
          <TextBlock Text="{TemplateBinding Label}"
                     FontSize="13"
                     FontWeight="SemiBold" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource DiscSpace2}">
            <TextBox Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                     PlaceholderText="{TemplateBinding Watermark}"
                     IsReadOnly="{TemplateBinding IsReadOnly}" />
            <Button Grid.Column="1"
                    Classes="secondary"
                    Command="{TemplateBinding BrowseCommand}"
                    Content="{TemplateBinding BrowseText}"
                    IsVisible="{TemplateBinding ShowBrowse}" />
          </Grid>
          <TextBlock Text="{TemplateBinding Hint}"
                     Foreground="{DynamicResource DiscTextMutedBrush}"
                     FontSize="12"
                     TextWrapping="Wrap" />
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="controls|EmptyState">
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel HorizontalAlignment="Center" MaxWidth="420" Spacing="{DynamicResource DiscSpace3}">
          <Border Background="{DynamicResource DiscSurfaceRaisedBrush}"
                  BorderBrush="{DynamicResource DiscBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource DiscRadiusCard}"
                  Height="64"
                  Width="64"
                  HorizontalAlignment="Center">
            <TextBlock Text="○" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource DiscTextMutedBrush}" />
          </Border>
          <TextBlock Text="{TemplateBinding Title}" FontSize="16" FontWeight="SemiBold"
                     TextAlignment="Center" />
          <TextBlock Text="{TemplateBinding Description}" Foreground="{DynamicResource DiscTextMutedBrush}"
                     TextAlignment="Center" TextWrapping="Wrap" />
          <ContentPresenter Content="{TemplateBinding Content}" />
          <Button Classes="primary"
                  Command="{TemplateBinding ActionCommand}"
                  Content="{TemplateBinding ActionText}"
                  HorizontalAlignment="Center"
                  IsVisible="{TemplateBinding IsActionVisible}" />
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </Style>

  <!-- Sidebar project group: section caption, the open project and a dirty indicator. -->
  <Style Selector="TextBlock.sidebar-section">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="1.1" />
    <Setter Property="Foreground" Value="{DynamicResource DiscTextMutedBrush}" />
    <Setter Property="Margin" Value="14,0,0,6" />
  </Style>

  <Style Selector="Grid.sidebar-project">
    <Setter Property="Height" Value="40" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>

  <Style Selector="TextBlock.sidebar-project-name">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Ellipse.sidebar-dirty-dot">
    <Setter Property="Width" Value="7" />
    <Setter Property="Height" Value="7" />
    <Setter Property="Fill" Value="{DynamicResource DiscAccentBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="WrapPanel.project-title-row > :is(Control)">
    <Setter Property="Margin" Value="0,0,8,2" />
  </Style>

  <!-- Design page side panel: tabs, layer rows, property fields, tone and disc files. -->
  <Style Selector="Border.design-panel">
    <Setter Property="Background" Value="{DynamicResource DiscSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DiscBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource DiscRadiusCard}" />
    <Setter Property="Padding" Value="14" />
  </Style>

  <Style Selector="Border.design-tabs">
    <Setter Property="Background" Value="{DynamicResource DiscSurfaceRaisedBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource DiscRadiusField}" />
    <Setter Property="Padding" Value="3" />
  </Style>

  <Style Selector="Button.design-tab">
    <Setter Property="Height" Value="30" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource DiscTextMutedBrush}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.design-tab /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
    <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <Style Selector="Button.design-tab:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource DiscTextBrush}" />
  </Style>

  <Style Selector="Button.design-tab.active">
    <Setter Property="Background" Value="{DynamicResource DiscSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource DiscTextBrush}" />
  </Style>

  <Style Selector="ScrollViewer.layer-list-scroll">
    <Setter Property="MaxHeight" Value="380" />
  </Style>

  <Style Selector="Border.layer-row">
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="Background" Value="{DynamicResource DiscSurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource DiscRadiusField}" />
    <Setter Property="Padding" Value="4,4,6,4" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Border.layer-row:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource DiscBorderBrush}" />
  </Style>

  <Style Selector="Border.layer-row.selected">
    <Setter Property="Background" Value="{DynamicResource DiscAccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DiscAccentBrush}" />
  </Style>

  <Style Selector="Border.layer-row.hidden TextBlock.layer-name">
    <Setter Property="Opacity" Value="0.55" />
  </Style>

  <Style Selector="Border.layer-row.dragging">
    <Setter Property="Opacity" Value="0.55" />
  </Style>

  <Style Selector="Border.layer-row.drop-target">
    <Setter Property="BorderBrush" Value="{DynamicResource DiscAccentBrush}" />
    <Setter Property="BorderThickness" Value="0,2,0,0" />
  </Style>

  <Style Selector="Border.layer-grip">
    <Setter Property="Width" Value="16" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="SizeNorthSouth" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>

  <Style Selector="Ellipse.grip-dot">
    <Setter Property="Width" Value="3" />
    <Setter Property="Height" Value="3" />
    <Setter Property="Fill" Value="{DynamicResource DiscTextMutedBrush}" />
  </Style>

  <Style Selector="Border.layer-thumb">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="Background" Value="{DynamicResource DiscSurfaceBrush}" />
  </Style>

  <Style Selector="TextBlock.layer-thumb-missing">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource DiscWarningBrush}" />
  </Style>

  <Style Selector="Button.layer-select">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.layer-select /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource DiscTextBrush}" />
  </Style>

  <Style Selector="TextBlock.layer-name">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.layer-missing">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource DiscWarningBrush}" />
  </Style>

  <Style Selector="Ellipse.eye-pupil">
    <Setter Property="Fill" Value="{DynamicResource DiscTextBrush}" />
  </Style>

  <Style Selector="Path.button-icon">
    <Setter Property="Stroke" Value="{DynamicResource DiscOnAccentBrush}" />
    <Setter Property="StrokeThickness" Value="2.4" />
    <Setter Property="StrokeLineCap" Value="Round" />
  </Style>

  <Style Selector="Border.design-divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource DiscBorderBrush}" />
  </Style>

  <Style Selector="Button.danger:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource DiscDangerBrush}" />
  </Style>

  <Style Selector="TextBox.numeric-field">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <Style Selector="TextBox.numeric-field.invalid">
    <Setter Property="BorderBrush" Value="{DynamicResource DiscDangerBrush}" />
  </Style>

  <Style Selector="TextBlock.numeric-field-unit">
    <Setter Property="Margin" Value="0,0,10,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource DiscTextMutedBrush}" />
  </Style>

  <Style Selector="TextBlock.numeric-field-error">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource DiscDangerBrush}" />
  </Style>

  <Style Selector="Border.layer-source">
    <Setter Property="Background" Value="{DynamicResource DiscSurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DiscBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource DiscRadiusField}" />
    <Setter Property="Padding" Value="10,8" />
  </Style>

  <Style Selector="Border.layer-source.missing">
    <Setter Property="BorderBrush" Value="{DynamicResource DiscWarningBrush}" />
  </Style>

  <Style Selector="TextBlock.tone-value">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource DiscAccentBrush}" />
  </Style>

  <!-- Disc files look like a folder/document, never like an image layer. -->
  <Style Selector="Border.disc-files-card">
    <Setter Property="Background" Value="{DynamicResource DiscSurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DiscBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource DiscRadiusField}" />
    <Setter Property="Padding" Value="12" />
  </Style>

  <Style Selector="Border.disc-files-card.missing">
    <Setter Property="BorderBrush" Value="{DynamicResource DiscWarningBrush}" />
  </Style>

  <Style Selector="WrapPanel.action-row > Button">
    <Setter Property="Margin" Value="0,0,8,8" />
  </Style>

  <!-- Design canvas card: a fixed-height frame so the canvas never collapses inside the page scroll. -->
  <Style Selector="Border.design-canvas-card">
    <Setter Property="Background" Value="{DynamicResource DiscSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DiscBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource DiscRadiusCard}" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <Style Selector="Border.design-canvas-frame">
    <Setter Property="Height" Value="560" />
    <Setter Property="CornerRadius" Value="{DynamicResource DiscRadiusField}" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="BorderBrush" Value="{DynamicResource DiscBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Border.design-canvas-frame:focus-within">
    <Setter Property="BorderBrush" Value="{DynamicResource DiscAccentBrush}" />
  </Style>

  <Style Selector="TextBlock.design-zoom-percent">
    <Setter Property="MinWidth" Value="48" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource DiscTextMutedBrush}" />
  </Style>

  <Style Selector="Border.home-continue">
    <Setter Property="Background" Value="{DynamicResource DiscSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DiscAccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource DiscRadiusCard}" />
    <Setter Property="Padding" Value="22,18" />
    <Setter Property="BoxShadow" Value="0 6 22 0 #1A000000" />
  </Style>

  <Style Selector="Border.home-hero">
    <Setter Property="Background" Value="{DynamicResource DiscSurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DiscBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource DiscRadiusCard}" />
    <Setter Property="Padding" Value="28" />
    <Setter Property="BoxShadow" Value="0 8 28 0 #1A000000" />
  </Style>

  <Style Selector="TextBlock.home-eyebrow">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource DiscAccentBrush}" />
    <Setter Property="LetterSpacing" Value="1.2" />
  </Style>

  <Style Selector="TextBlock.home-hero-title">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="MaxWidth" Value="560" />
  </Style>

  <Style Selector="TextBlock.home-hero-description">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource DiscTextMutedBrush}" />
    <Setter Property="MaxWidth" Value="600" />
  </Style>

  <Style Selector="Border.home-disc-illustration">
    <Setter Property="Width" Value="168" />
    <Setter Property="Height" Value="168" />
    <Setter Property="CornerRadius" Value="84" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Optical disc artwork. Radii follow a 120 mm disc scaled to 100 units: 7.5 mm hole,
       16.5 mm clamping area, 23 mm mirror band, 58 mm data edge and 60 mm rim. -->
  <Style Selector="controls|DiscArt">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="Template">
      <ControlTemplate>
        <!-- The canvas reserves room around the disc so its drop shadow is never clipped. -->
        <Viewbox Stretch="Uniform">
          <Canvas Width="108" Height="108">
            <Canvas Canvas.Left="4" Canvas.Top="3">
            <Border Classes="disc-art-shadow" Width="100" Height="100" CornerRadius="50" />
            <Path x:Name="PART_Data" Data="F0 M0,50 A50,50 0 1 0 100,50 A50,50 0 1 0 0,50 Z M30.8,50 A19.2,19.2 0 1 0 69.2,50 A19.2,19.2 0 1 0 30.8,50 Z" Fill="{DynamicResource DiscArtCdSurfaceBrush}" />
            <Path x:Name="PART_Artwork" IsVisible="False" Data="F0 M0,50 A50,50 0 1 0 100,50 A50,50 0 1 0 0,50 Z M30.8,50 A19.2,19.2 0 1 0 69.2,50 A19.2,19.2 0 1 0 30.8,50 Z" />
            <Path Data="F0 M0,50 A50,50 0 1 0 100,50 A50,50 0 1 0 0,50 Z M30.8,50 A19.2,19.2 0 1 0 69.2,50 A19.2,19.2 0 1 0 30.8,50 Z" Fill="{DynamicResource DiscArtGlossBrush}" />
            <Canvas IsHitTestVisible="False">
                <Ellipse Classes="disc-art-groove" Canvas.Left="6" Canvas.Top="6" Width="88" Height="88" />
                <Ellipse Classes="disc-art-groove" Canvas.Left="11.5" Canvas.Top="11.5" Width="77" Height="77" />
                <Ellipse Classes="disc-art-groove" Canvas.Left="17.5" Canvas.Top="17.5" Width="65" Height="65" />
                <Ellipse Classes="disc-art-groove" Canvas.Left="24" Canvas.Top="24" Width="52" Height="52" />
            </Canvas>
            <Path Data="F0 M0,50 A50,50 0 1 0 100,50 A50,50 0 1 0 0,50 Z M1.7,50 A48.3,48.3 0 1 0 98.3,50 A48.3,48.3 0 1 0 1.7,50 Z" Fill="{DynamicResource DiscArtRimBrush}" />
            <Path Data="F0 M30.8,50 A19.2,19.2 0 1 0 69.2,50 A19.2,19.2 0 1 0 30.8,50 Z M36.25,50 A13.75,13.75 0 1 0 63.75,50 A13.75,13.75 0 1 0 36.25,50 Z" Fill="{DynamicResource DiscArtMirrorBrush}" />
            <Path Data="F0 M36.25,50 A13.75,13.75 0 1 0 63.75,50 A13.75,13.75 0 1 0 36.25,50 Z M43.75,50 A6.25,6.25 0 1 0 56.25,50 A6.25,6.25 0 1 0 43.75,50 Z" Fill="{DynamicResource DiscArtHubBrush}" />
            <Ellipse Classes="disc-art-stacking-ring" Canvas.Left="40.6" Canvas.Top="40.6" Width="18.8" Height="18.8" />
            <Ellipse Classes="disc-art-outline" Canvas.Left="0.3" Canvas.Top="0.3" Width="99.4" Height="99.4" />
            <Ellipse Classes="disc-art-outline" Canvas.Left="43.75" Canvas.Top="43.75" Width="12.5" Height="12.5" />
            </Canvas>
          </Canvas>
        </Viewbox>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="controls|DiscArt[Variant=dvd] /template/ Path#PART_Data">
    <Setter Property="Fill" Value="{DynamicResource DiscArtDvdSurfaceBrush}" />
  </Style>

  <Style Selector="controls|DiscArt[Variant=bd] /template/ Path#PART_Data">
    <Setter Property="Fill" Value="{DynamicResource DiscArtBdSurfaceBrush}" />
  </Style>

  <Style Selector="Border.disc-art-shadow">
    <Setter Property="BoxShadow" Value="0 2 6 0 #38000000" />
  </Style>

  <Style Selector="Ellipse.disc-art-groove">
    <Setter Property="Stroke" Value="#2EFFFFFF" />
    <Setter Property="StrokeThickness" Value="0.45" />
  </Style>

  <Style Selector="Ellipse.disc-art-stacking-ring">
    <Setter Property="Stroke" Value="#38000000" />
    <Setter Property="StrokeThickness" Value="0.6" />
  </Style>

  <Style Selector="Ellipse.disc-art-outline">
    <Setter Property="Stroke" Value="#40000000" />
    <Setter Property="StrokeThickness" Value="0.6" />
  </Style>

  <Style Selector="controls|DiscArt.hero">
    <Setter Property="Width" Value="132" />
    <Setter Property="Height" Value="132" />
    <Setter Property="RenderTransform" Value="rotate(0deg)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:1.4" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <!-- A slow spin moves the iridescent sheen, as a real disc catching the light. -->
  <Style Selector="Border.home-hero:pointerover controls|DiscArt.hero">
    <Setter Property="RenderTransform" Value="rotate(120deg)" />
  </Style>

  <Style Selector="Button.media-template">
    <Setter Property="Width" Value="232" />
    <Setter Property="Height" Value="176" />
    <Setter Property="Margin" Value="0,0,12,12" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="Background" Value="{DynamicResource DiscSurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DiscBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource DiscRadiusCard}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <!-- Integer translation keeps text crisp; fractional scale blurred and shifted the labels. -->
    <Setter Property="RenderTransform" Value="translateY(0px)" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.18" Easing="SineEaseOut" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.18" Easing="SineEaseOut" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="SineEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.media-template:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource DiscAccentBrush}" />
    <Setter Property="RenderTransform" Value="translateY(-2px)" />
  </Style>

  <Style Selector="Button.media-template:pressed">
    <Setter Property="RenderTransform" Value="translateY(0px)" />
  </Style>

  <Style Selector="Button.media-template.selected">
    <Setter Property="Background" Value="{DynamicResource DiscAccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DiscAccentBrush}" />
  </Style>

  <Style Selector="Button.media-template:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource DiscAccentBrush}" />
  </Style>

  <Style Selector="Border.media-template-selected-chip">
    <Setter Property="Background" Value="{DynamicResource DiscAccentBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource DiscRadiusChip}" />
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.media-template-selected-chip TextBlock">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource DiscOnAccentBrush}" />
  </Style>

  <Style Selector="Border.media-template-badge">
    <Setter Property="Background" Value="{DynamicResource DiscAccentSoftBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource DiscRadiusChip}" />
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.media-template-badge-text">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource DiscAccentBrush}" />
  </Style>

  <Style Selector="TextBlock.media-template-capacity">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource DiscTextMutedBrush}" />
  </Style>

  <Style Selector="TextBlock.media-template-description">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource DiscTextMutedBrush}" />
  </Style>

  <Style Selector="Border.home-selection-status">
    <Setter Property="Background" Value="{DynamicResource DiscAccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DiscBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource DiscRadiusField}" />
    <Setter Property="Padding" Value="12,9" />
  </Style>

  <Style Selector="Button.recent-card">
    <Setter Property="Width" Value="232" />
    <Setter Property="Height" Value="212" />
    <Setter Property="Padding" Value="14" />
    <Setter Property="Background" Value="{DynamicResource DiscSurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DiscBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource DiscRadiusCard}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="RenderTransform" Value="translateY(0px)" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.18" Easing="SineEaseOut" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="SineEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.recent-card /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
    <Setter Property="BorderBrush" Value="{Binding $parent[Button].BorderBrush}" />
    <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
  </Style>

  <Style Selector="Button.recent-card:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource DiscAccentBrush}" />
    <Setter Property="RenderTransform" Value="translateY(-2px)" />
  </Style>

  <Style Selector="Button.recent-card:pressed">
    <Setter Property="RenderTransform" Value="translateY(0px)" />
  </Style>

  <Style Selector="Grid.recent-card-host.issue Button.recent-card">
    <Setter Property="Opacity" Value="0.78" />
  </Style>

  <Style Selector="controls|DiscArt.recent-fallback-art">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.25" Easing="SineEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <!-- While the background probe runs the card shows dimmed family artwork as a placeholder. -->
  <Style Selector="controls|DiscArt.recent-fallback-art.probing">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <Style Selector="Border.recent-status">
    <Setter Property="Background" Value="{DynamicResource DiscSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DiscDangerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource DiscRadiusChip}" />
    <Setter Property="Padding" Value="7,2" />
  </Style>

  <Style Selector="Border.recent-status TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource DiscDangerBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.recent-path">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource DiscTextMutedBrush}" />
  </Style>

  <Style Selector="Button.recent-remove">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,8,20,0" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Opacity" Value="0.7" />
  </Style>

  <Style Selector="Grid.recent-card-host:pointerover Button.recent-remove, Button.recent-remove:focus-visible">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="Path.recent-remove-icon">
    <Setter Property="Stroke" Value="{DynamicResource DiscTextMutedBrush}" />
    <Setter Property="StrokeThickness" Value="2.2" />
    <Setter Property="StrokeLineCap" Value="Round" />
  </Style>

  <Style Selector="Button.recent-remove:pointerover Path.recent-remove-icon">
    <Setter Property="Stroke" Value="{DynamicResource DiscDangerBrush}" />
  </Style>

  <Style Selector="Border.home-recent-empty">
    <Setter Property="Background" Value="{DynamicResource DiscSurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DiscBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource DiscRadiusField}" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <Style Selector="Border.home-folder-icon">
    <Setter Property="Width" Value="54" />
    <Setter Property="Height" Value="54" />
    <Setter Property="Background" Value="{DynamicResource DiscAccentSoftBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource DiscRadiusField}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Path.home-folder-shape">
    <Setter Property="Fill" Value="{DynamicResource DiscAccentBrush}" />
  </Style>

  <Style Selector="Path.home-folder-tab">
    <Setter Property="Stroke" Value="{DynamicResource DiscAccentHoverBrush}" />
    <Setter Property="StrokeThickness" Value="2" />
  </Style>

  <Style Selector="TextBlock.home-recent-description">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource DiscTextMutedBrush}" />
  </Style>

  <Style Selector="TextBlock.home-platform-description">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource DiscTextMutedBrush}" />
  </Style>

  <Style Selector="Button.home-open-recent">
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="8,0" />
  </Style>

  <Style Selector="Border.new-project-dialog">
    <Setter Property="Background" Value="{DynamicResource DiscSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DiscBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BoxShadow" Value="0 16 48 0 #66000000" />
    <Setter Property="CornerRadius" Value="{DynamicResource DiscRadiusCard}" />
    <!-- The right inset is split with the scroll content: the 22px content gutter holds the overlay
         scrollbar even at its expanded (pointer-over) width, so it never covers fields. -->
    <Setter Property="Padding" Value="24,24,4,24" />
    <Setter Property="MaxWidth" Value="760" />
    <Setter Property="MaxHeight" Value="720" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.new-project-description">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource DiscTextMutedBrush}" />
  </Style>

  <Style Selector="TextBlock.new-project-field-hint">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource DiscTextMutedBrush}" />
  </Style>

  <Style Selector="TextBlock.new-project-preset-description">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource DiscTextMutedBrush}" />
  </Style>

  <Style Selector="Button.new-project-family">
    <Setter Property="Height" Value="64" />
    <Setter Property="Margin" Value="0,0,10,0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="Background" Value="{DynamicResource DiscSurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DiscBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource DiscRadiusField}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.16" Easing="SineEaseOut" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.16" Easing="SineEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.new-project-family:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource DiscAccentBrush}" />
  </Style>

  <Style Selector="Button.new-project-family.selected">
    <Setter Property="Background" Value="{DynamicResource DiscAccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DiscAccentBrush}" />
  </Style>

  <Style Selector="TextBlock.new-project-family-capacity">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource DiscTextMutedBrush}" />
  </Style>

  <Style Selector="ComboBox.new-project-preset">
    <Setter Property="MinHeight" Value="44" />
  </Style>

  <Style Selector="Border.new-project-error">
    <Setter Property="Background" Value="{DynamicResource DiscAccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DiscDangerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource DiscRadiusField}" />
    <Setter Property="Padding" Value="12,9" />
  </Style>
</Styles>
