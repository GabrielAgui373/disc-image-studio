<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:calibration="using:DiscImageStudio.App.Avalonia.ViewModels.Calibration"
             xmlns:export="using:DiscImageStudio.App.Avalonia.ViewModels.Export"
             xmlns:controls="using:DiscImageStudio.App.Avalonia.Controls"
             x:Class="DiscImageStudio.App.Avalonia.Views.CalibrationWorkspaceView"
             x:DataType="calibration:CalibrationWorkspaceViewModel">
    <StackPanel Spacing="16">
        <!-- The three steps; the curve arrives with Task 12.4. -->
        <Border Classes="design-panel">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="10">
                <Button Classes="calibration-step" Classes.active="{Binding IsTargetStep}"
                        Content="{Binding StepTargetLabel}" Command="{Binding ShowTargetStepCommand}" />
                <Button Grid.Column="1" Classes="calibration-step" Classes.active="{Binding IsPhotoStep}"
                        Content="{Binding StepPhotoLabel}" Command="{Binding ShowPhotoStepCommand}"
                        ToolTip.Tip="{Binding NeedsSessionText}" />
                <Button Grid.Column="2" Classes="calibration-step" IsEnabled="False"
                        Content="{Binding StepCurveLabel}" />
                <TextBlock Grid.Column="3" Text="{Binding StepLaterHint}" Classes="settings-hint"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
            </Grid>
        </Border>

        <Grid x:Name="Panes" ColumnDefinitions="*,340" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="16"
              IsVisible="{Binding IsTargetStep}">
            <Border x:Name="TargetPane" Classes="design-panel" VerticalAlignment="Top">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding TargetTitle}" Classes="settings-section-title" />
                        <TextBlock Text="{Binding TargetDescription}" Classes="settings-hint" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding MediaLabel}" Classes="settings-field-label" />
                        <Border Classes="design-tabs">
                            <UniformGrid Rows="1">
                                <Button Classes="design-tab" Classes.active="{Binding IsCd}"
                                        Content="{Binding CdLabel}" Command="{Binding UseCdCommand}" />
                                <Button Classes="design-tab" Classes.active="{Binding IsDvd}"
                                        Content="{Binding DvdLabel}" Command="{Binding UseDvdCommand}" />
                                <Button Classes="design-tab" Classes.active="{Binding IsBluRay}"
                                        Content="{Binding BluRayLabel}" Command="{Binding UseBluRayCommand}" />
                            </UniformGrid>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding SourceLabel}" Classes="settings-field-label" />
                        <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="calibration:CalibrationSourceOption">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}" Classes="settings-hint" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <ItemsControl ItemsSource="{Binding Summary}" VerticalAlignment="Top">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="export:ExportSummaryRow">
                                    <Border Classes="export-row">
                                        <Grid ColumnDefinitions="120,*" ColumnSpacing="12">
                                            <TextBlock Text="{Binding Label}" Classes="settings-field-label" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Grid.Column="1" Spacing="6" Width="260">
                            <Border Classes="calibration-preview" Width="260" Height="260">
                                <Grid>
                                    <Image Source="{Binding TargetImage}" Stretch="Uniform" />
                                    <ProgressBar IsIndeterminate="True" Width="80" VerticalAlignment="Center"
                                                 IsVisible="{Binding IsRendering}" />
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding PreviewHint}" Classes="settings-hint" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border x:Name="SidePane" Grid.Column="1" Classes="design-panel" VerticalAlignment="Top">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="8" IsVisible="{Binding IsCd}">
                        <TextBlock Text="{Binding FormatLabel}" Classes="settings-field-label" />
                        <Border Classes="design-tabs">
                            <UniformGrid Rows="1">
                                <Button Classes="design-tab" Classes.active="{Binding IsWaveFormat}"
                                        Content="{Binding WaveLabel}" Command="{Binding UseWaveCommand}" />
                                <Button Classes="design-tab" Classes.active="{Binding IsRawFormat}"
                                        Content="{Binding RawLabel}" Command="{Binding UseRawCommand}" />
                            </UniformGrid>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding DestinationTitle}" Classes="settings-field-label" />
                        <Border Classes="export-destination">
                            <TextBlock Text="{Binding TargetPath}" TextWrapping="Wrap" Classes="settings-path" />
                        </Border>
                        <Button Classes="secondary" HorizontalAlignment="Stretch" Content="{Binding BrowseLabel}"
                                Command="{Binding BrowseCommand}" />
                        <TextBlock Text="{Binding SpaceText}" Classes="settings-hint" TextWrapping="Wrap"
                                   Classes.export-space-short="{Binding IsSpaceShort}" />
                    </StackPanel>

                    <StackPanel Spacing="6" IsVisible="{Binding HasProblems}">
                        <TextBlock Text="{Binding ProblemsTitle}" Classes="settings-field-label" />
                        <Border Classes="settings-asset-summary missing">
                            <ItemsControl ItemsSource="{Binding Problems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>

                    <Border Classes="export-status" Classes.ready="{Binding IsReady}" IsVisible="{Binding !IsRunning}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <CheckBox IsChecked="{Binding VerifyHash}" IsEnabled="{Binding IsReady}">
                                <TextBlock Text="{Binding VerifyHashLabel}" TextWrapping="Wrap" />
                            </CheckBox>
                            <Button Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Command="{Binding GenerateCommand}" IsVisible="{Binding !IsConfirmingReplace}">
                                <TextBlock Text="{Binding GenerateLabel}" Foreground="{DynamicResource DiscOnAccentBrush}" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Classes="export-confirm" IsVisible="{Binding IsConfirmingReplace}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{Binding ReplaceTitle}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ReplaceText}" Classes="settings-hint" TextWrapping="Wrap" />
                            <UniformGrid Rows="1" ColumnSpacing="8">
                                <Button Classes="secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Content="{Binding KeepLabel}" Command="{Binding KeepExistingCommand}" />
                                <Button Classes="danger" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Content="{Binding ReplaceLabel}" Command="{Binding ConfirmReplaceCommand}" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Classes="export-status" IsVisible="{Binding IsRunning}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding StageText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}"
                                         IsIndeterminate="{Binding !IsProgressKnown}" />
                            <TextBlock Text="{Binding ProgressText}" Classes="settings-hint" TextWrapping="Wrap" />
                            <Button Classes="secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Content="{Binding CancelRunLabel}" Command="{Binding CancelRunCommand}" />
                        </StackPanel>
                    </Border>

                    <Border Classes="export-outcome" Classes.succeeded="{Binding IsSucceeded}" IsVisible="{Binding HasOutcome}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding OutcomeTitle}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding OutcomeText}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ResultPath}" Classes="settings-path" TextWrapping="Wrap"
                                       IsVisible="{Binding IsSucceeded}" />
                            <ItemsControl ItemsSource="{Binding ResultChecks}" IsVisible="{Binding IsSucceeded}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{Binding}" Classes="settings-hint" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <UniformGrid Columns="2" ColumnSpacing="8" IsVisible="{Binding IsSucceeded}">
                                <Button Classes="secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Content="{Binding OpenFolderLabel}" Command="{Binding OpenFolderCommand}" />
                                <Button Classes="secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Content="{Binding CopyPathLabel}" Command="{Binding CopyPathCommand}" />
                            </UniformGrid>
                            <TextBlock Text="{Binding ActionStatus}" Classes="settings-hint"
                                       IsVisible="{Binding ActionStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <Button Classes="ghost" HorizontalAlignment="Right" Content="{Binding DoneLabel}" Command="{Binding DoneCommand}" />
                        </StackPanel>
                    </Border>

                    <!-- The session saved with the project. -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding SessionTitle}" Classes="settings-field-label" />
                        <Border Classes="settings-asset-summary" Classes.missing="{Binding IsLinkedSessionBroken}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding LinkedSessionText}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding LinkedSessionPath}" Classes="settings-path" TextWrapping="Wrap"
                                           IsVisible="{Binding HasLinkedSession}" />
                            </StackPanel>
                        </Border>
                        <UniformGrid Columns="2" ColumnSpacing="8">
                            <Button Classes="secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Content="{Binding OpenSessionLabel}" Command="{Binding OpenSessionCommand}" />
                            <Button Classes="secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Content="{Binding UnlinkSessionLabel}" Command="{Binding UnlinkSessionCommand}"
                                    IsEnabled="{Binding HasLinkedSession}" />
                        </UniformGrid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Step 2: the photo and its edges. -->
        <Grid x:Name="PhotoPanes" ColumnDefinitions="*,340" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="16"
              IsVisible="{Binding IsPhotoStep}">
            <Border x:Name="CanvasPane" Classes="design-panel" VerticalAlignment="Top">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding PhotoTitle}" Classes="settings-section-title" />
                            <TextBlock Text="{Binding PhotoDescription}" Classes="settings-hint" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
                            <Button Classes="ghost" Content="−" Command="{Binding PhotoCanvas.ZoomOutCommand}" />
                            <TextBlock Text="{Binding PhotoCanvas.ZoomText}" VerticalAlignment="Center" MinWidth="44"
                                       TextAlignment="Center" Classes="settings-hint" />
                            <Button Classes="ghost" Content="+" Command="{Binding PhotoCanvas.ZoomInCommand}" />
                            <Button Classes="ghost" Content="{Binding FitLabel}" Command="{Binding PhotoCanvas.FitViewCommand}" />
                        </StackPanel>
                    </Grid>
                    <Border Classes="calibration-canvas" Height="560">
                        <controls:CalibrationPhotoCanvas ViewModel="{Binding PhotoCanvas}" />
                    </Border>
                    <TextBlock Text="{Binding PhotoCanvas.HintText}" Classes="settings-hint" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border x:Name="PhotoSide" Grid.Column="1" Classes="design-panel" VerticalAlignment="Top">
                <StackPanel Spacing="16">
                    <Border Classes="export-confirm" IsVisible="{Binding HasRecoveryDraft}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding RecoveryText}" TextWrapping="Wrap" />
                            <UniformGrid Rows="1" ColumnSpacing="8">
                                <Button Classes="secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Content="{Binding DiscardDraftLabel}" Command="{Binding DiscardDraftCommand}" />
                                <Button Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Command="{Binding RestoreDraftCommand}">
                                    <TextBlock Text="{Binding RestoreDraftLabel}" Foreground="{DynamicResource DiscOnAccentBrush}" />
                                </Button>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <StackPanel Spacing="8">
                        <Button Classes="secondary" HorizontalAlignment="Stretch" Content="{Binding ImportPhotoLabel}"
                                Command="{Binding ImportPhotoCommand}" IsEnabled="{Binding !IsPhotoBusy}" />
                        <TextBlock Text="{Binding PhotoInfo}" Classes="settings-hint" TextWrapping="Wrap"
                                   IsVisible="{Binding PhotoInfo, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>

                    <StackPanel Spacing="8" IsVisible="{Binding HasPhoto}">
                        <TextBlock Text="{Binding DiscSizeLabel}" Classes="settings-field-label" />
                        <Border Classes="design-tabs" IsEnabled="{Binding !IsRectificationConfirmed}">
                            <UniformGrid Rows="1">
                                <Button Classes="design-tab" Classes.active="{Binding IsDisc12}"
                                        Content="{Binding Disc12Label}" Command="{Binding UseDisc12Command}" />
                                <Button Classes="design-tab" Classes.active="{Binding IsDisc8}"
                                        Content="{Binding Disc8Label}" Command="{Binding UseDisc8Command}" />
                            </UniformGrid>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="8" IsVisible="{Binding HasPhoto}">
                        <TextBlock Text="{Binding OrientationLabel}" Classes="settings-field-label" />
                        <UniformGrid Rows="1" ColumnSpacing="8" IsEnabled="{Binding !IsRectificationConfirmed}">
                            <Button Classes="secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Content="{Binding MirrorLabel}" Command="{Binding MirrorPhotoCommand}" />
                            <Button Classes="secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Content="{Binding RotateLabel}" Command="{Binding RotatePhotoCommand}" />
                        </UniformGrid>
                    </StackPanel>

                    <Border Classes="export-status" Classes.ready="{Binding HasRectification}" IsVisible="{Binding HasPhoto}">
                        <StackPanel Spacing="10">
                            <StackPanel Spacing="8" IsVisible="{Binding IsPhotoBusy}">
                                <TextBlock Text="{Binding PhotoBusyText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <ProgressBar IsIndeterminate="True" />
                                <Button Classes="secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Content="{Binding CancelPhotoWorkLabel}" Command="{Binding CancelPhotoWorkCommand}" />
                            </StackPanel>
                            <TextBlock Text="{Binding RectificationText}" FontWeight="SemiBold" TextWrapping="Wrap"
                                       IsVisible="{Binding HasRectification}" />
                            <Button Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Command="{Binding RectifyCommand}" IsEnabled="{Binding !IsPhotoBusy}"
                                    IsVisible="{Binding !IsRectificationConfirmed}">
                                <TextBlock Text="{Binding RectifyLabel}" Foreground="{DynamicResource DiscOnAccentBrush}" />
                            </Button>
                            <UniformGrid Rows="1" ColumnSpacing="8" IsVisible="{Binding HasRectification}">
                                <Button Classes="design-tab" Classes.active="{Binding !PhotoCanvas.ShowRectified}"
                                        Content="{Binding ShowPhotoLabel}" Command="{Binding ShowPhotoCommand}" />
                                <Button Classes="design-tab" Classes.active="{Binding PhotoCanvas.ShowRectified}"
                                        Content="{Binding ShowRectifiedLabel}" Command="{Binding ShowRectifiedViewCommand}" />
                            </UniformGrid>
                            <Button Classes="secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Content="{Binding ConfirmLabel}" Command="{Binding ConfirmRectificationCommand}">
                                <Button.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="HasRectification" />
                                        <Binding Path="!IsRectificationConfirmed" />
                                    </MultiBinding>
                                </Button.IsVisible>
                            </Button>
                            <TextBlock Text="{Binding ConfirmedText}" TextWrapping="Wrap" IsVisible="{Binding IsRectificationConfirmed}" />
                            <Button Classes="ghost" HorizontalAlignment="Left" Content="{Binding ReopenLabel}"
                                    Command="{Binding ReopenEdgesCommand}" IsVisible="{Binding IsRectificationConfirmed}" />
                        </StackPanel>
                    </Border>

                    <Border Classes="settings-asset-summary missing" IsVisible="{Binding HasPhotoError}">
                        <TextBlock Text="{Binding PhotoError}" TextWrapping="Wrap" />
                    </Border>

                    <StackPanel Spacing="6" IsVisible="{Binding HasPhoto}">
                        <Button Classes="secondary" HorizontalAlignment="Stretch" Content="{Binding SaveSessionLabel}"
                                Command="{Binding SavePhotoCommand}" IsEnabled="{Binding !IsPhotoBusy}" />
                        <TextBlock Text="{Binding PhotoSaveText}" Classes="settings-hint" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
