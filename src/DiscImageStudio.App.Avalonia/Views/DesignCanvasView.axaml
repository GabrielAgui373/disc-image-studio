<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:DiscImageStudio.App.Avalonia.Controls"
             xmlns:vm="using:DiscImageStudio.App.Avalonia.ViewModels.Design"
             x:Class="DiscImageStudio.App.Avalonia.Views.DesignCanvasView"
             x:DataType="vm:DesignCanvasViewModel">
    <Border Classes="design-canvas-card">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Classes="settings-section-title" Text="{Binding CanvasTitle}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <ToggleButton Classes="ghost compact-action history-action canvas-tone-toggle"
                                  IsChecked="{Binding IsHandTool}"
                                  ToolTip.Tip="{Binding HandToolTip}"
                                  AutomationProperties.Name="{Binding HandToolTip}">
                        <Viewbox Width="14" Height="14">
                            <Canvas Width="24" Height="24">
                                <Path Classes="history-icon" Data="M8,12 V5.5 A1.5,1.5 0 0 1 11,5.5 V11 M11,10 V4 A1.5,1.5 0 0 1 14,4 V11 M14,10 V5.5 A1.5,1.5 0 0 1 17,5.5 V12 M17,9 A1.5,1.5 0 0 1 20,9 V14 A6,6 0 0 1 14,20 H13 C10.5,20 9,19 7.5,17 L4.2,12.6 A1.6,1.6 0 0 1 6.6,10.5 L8,12" />
                            </Canvas>
                        </Viewbox>
                    </ToggleButton>
                    <Border Classes="toolbar-separator" />
                    <Button Classes="ghost compact-action history-action"
                            Command="{Binding ZoomOutCommand}"
                            ToolTip.Tip="{Binding ZoomOutLabel}"
                            AutomationProperties.Name="{Binding ZoomOutLabel}">
                        <Viewbox Width="13" Height="13">
                            <Canvas Width="24" Height="24">
                                <Path Classes="history-icon" Data="M5,12 H19" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <TextBlock Classes="design-zoom-percent" Text="{Binding ZoomPercent}" />
                    <Button Classes="ghost compact-action history-action"
                            Command="{Binding ZoomInCommand}"
                            ToolTip.Tip="{Binding ZoomInLabel}"
                            AutomationProperties.Name="{Binding ZoomInLabel}">
                        <Viewbox Width="13" Height="13">
                            <Canvas Width="24" Height="24">
                                <Path Classes="history-icon" Data="M5,12 H19 M12,5 V19" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button Classes="ghost compact-action"
                            Content="{Binding FitLabel}"
                            Command="{Binding FitCommand}" />
                    <ToggleButton Classes="ghost compact-action canvas-tone-toggle"
                                  Content="{Binding ToneLabel}"
                                  IsChecked="{Binding ShowTone}"
                                  ToolTip.Tip="{Binding ToneToolTip}"
                                  AutomationProperties.Name="{Binding ToneToolTip}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Classes="design-canvas-frame">
                <controls:DiscDesignCanvas ViewModel="{Binding}" />
            </Border>

            <TextBlock Grid.Row="2" Classes="settings-hint" Text="{Binding HintText}" TextWrapping="Wrap" />
        </Grid>
    </Border>
</UserControl>
