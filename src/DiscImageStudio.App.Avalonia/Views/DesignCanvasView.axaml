<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:DiscImageStudio.App.Avalonia.Controls"
             xmlns:vm="using:DiscImageStudio.App.Avalonia.ViewModels.Design"
             x:Class="DiscImageStudio.App.Avalonia.Views.DesignCanvasView"
             x:DataType="vm:DesignCanvasViewModel">
    <Border Classes="design-canvas-card">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Classes="settings-section-title" Text="{Binding CanvasTitle}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <Button Classes="ghost compact-action history-action"
                            Command="{Binding ZoomOutCommand}"
                            ToolTip.Tip="{Binding ZoomOutLabel}"
                            AutomationProperties.Name="{Binding ZoomOutLabel}">
                        <Viewbox Width="13" Height="13">
                            <Canvas Width="24" Height="24">
                                <Path Classes="history-icon" Data="M5,12 H19" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <TextBlock Classes="design-zoom-percent" Text="{Binding ZoomPercent}" />
                    <Button Classes="ghost compact-action history-action"
                            Command="{Binding ZoomInCommand}"
                            ToolTip.Tip="{Binding ZoomInLabel}"
                            AutomationProperties.Name="{Binding ZoomInLabel}">
                        <Viewbox Width="13" Height="13">
                            <Canvas Width="24" Height="24">
                                <Path Classes="history-icon" Data="M5,12 H19 M12,5 V19" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button Classes="ghost compact-action"
                            Content="{Binding FitLabel}"
                            Command="{Binding FitCommand}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Classes="design-canvas-frame">
                <controls:DiscDesignCanvas ViewModel="{Binding}" />
            </Border>

            <TextBlock Grid.Row="2" Classes="settings-hint" Text="{Binding HintText}" TextWrapping="Wrap" />
        </Grid>
    </Border>
</UserControl>
