<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:preview="using:DiscImageStudio.App.Avalonia.ViewModels.Preview"
             x:Class="DiscImageStudio.App.Avalonia.Views.PreviewWorkspaceView"
             x:DataType="preview:PreviewWorkspaceViewModel">
    <!-- Two panes on wide windows (picture | settings); the code-behind stacks them when narrow. -->
    <Grid x:Name="Panes" ColumnDefinitions="*,340" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="16">
        <Border x:Name="StagePane" Classes="design-panel" VerticalAlignment="Top">
            <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock Text="{Binding Summary}" Classes="settings-section-title" VerticalAlignment="Center" />
                    <Border Grid.Column="1"
                            Classes="preview-confidence"
                            Classes.approximate="{Binding IsApproximate}"
                            IsVisible="{Binding HasConfidence}">
                        <TextBlock Text="{Binding ConfidenceLabel}" />
                    </Border>
                </Grid>

                <!-- Shrinks the square stage on narrow windows, never enlarges it. -->
                <Viewbox StretchDirection="DownOnly" MaxWidth="620" HorizontalAlignment="Center">
                    <Border Classes="preview-stage">
                        <Grid>
                            <Image Source="{Binding Image}" Stretch="Uniform"
                                   RenderOptions.BitmapInterpolationMode="HighQuality" />
                            <Border Classes="composition-busy" IsVisible="{Binding IsRendering}">
                                <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ProgressBar IsIndeterminate="True" Width="160" />
                                    <TextBlock Text="{Binding RenderingLabel}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Viewbox>

                <Border Classes="new-project-error" IsVisible="{Binding HasError}">
                    <TextBlock Text="{Binding Error}" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Border>

        <Border x:Name="SidePane" Grid.Column="1" Classes="design-panel" VerticalAlignment="Top">
            <StackPanel Spacing="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding ModeTitle}" Classes="settings-field-label" />
                    <Border Classes="design-tabs">
                        <UniformGrid Rows="1">
                            <Button Classes="design-tab"
                                    Classes.active="{Binding IsProjectionMode}"
                                    Content="{Binding ProjectionLabel}"
                                    Command="{Binding ShowProjectionCommand}" />
                            <Button Classes="design-tab"
                                    Classes.active="{Binding IsArtifactMode}"
                                    Content="{Binding ArtifactLabel}"
                                    Command="{Binding ShowArtifactCommand}" />
                        </UniformGrid>
                    </Border>
                    <TextBlock Text="{Binding SourceDescription}" Classes="settings-hint" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding ViewTitle}" Classes="settings-field-label" />
                    <Border Classes="design-tabs">
                        <UniformGrid Rows="1">
                            <Button Classes="design-tab"
                                    Classes.active="{Binding IsDataMapView}"
                                    Content="{Binding DataMapLabel}"
                                    Command="{Binding ShowDataMapCommand}" />
                            <Button Classes="design-tab"
                                    Classes.active="{Binding ShowAppearance}"
                                    Content="{Binding AppearanceLabel}"
                                    Command="{Binding ShowAppearanceViewCommand}" />
                        </UniformGrid>
                    </Border>
                    <TextBlock Text="{Binding DataMapHint}" Classes="settings-hint" TextWrapping="Wrap"
                               IsVisible="{Binding IsDataMapView}" />
                    <StackPanel Spacing="6" IsVisible="{Binding ShowAppearance}">
                        <TextBlock Text="{Binding MediaLabel}" Classes="settings-field-label" />
                        <ComboBox ItemsSource="{Binding MediaOptions}"
                                  SelectedItem="{Binding SelectedMedia}"
                                  HorizontalAlignment="Stretch"
                                  AutomationProperties.Name="{Binding MediaLabel}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="preview:MediaAppearanceOption">
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{Binding AppearanceHint}" Classes="settings-hint" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding ResolutionLabel}" Classes="settings-field-label" />
                    <ComboBox ItemsSource="{Binding Sizes}"
                              SelectedItem="{Binding SelectedSize}"
                              HorizontalAlignment="Stretch"
                              AutomationProperties.Name="{Binding ResolutionLabel}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="preview:PreviewSizeOption">
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <CheckBox IsChecked="{Binding UseDraftSource}"
                              IsVisible="{Binding IsProjectionMode}"
                              Content="{Binding DraftLabel}" />
                    <TextBlock Text="{Binding DraftHint}"
                               Classes="settings-hint"
                               TextWrapping="Wrap"
                               IsVisible="{Binding IsProjectionMode}" />
                    <TextBlock Text="{Binding CostEstimate}" Classes="settings-hint" />
                    <TextBlock Text="{Binding CostWarning}" Classes="preview-cost-warning" TextWrapping="Wrap"
                               IsVisible="{Binding HasCostWarning}" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding OverlaysTitle}" Classes="settings-field-label" />
                    <CheckBox IsChecked="{Binding ShowFileSystem}" IsEnabled="{Binding HasFileSystemOverlay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Classes="preview-legend file-system" />
                            <TextBlock Text="{Binding FileSystemLabel}" />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox IsChecked="{Binding ShowUsefulRing}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Classes="preview-legend useful-ring" />
                            <TextBlock Text="{Binding UsefulRingLabel}" />
                        </StackPanel>
                    </CheckBox>
                </StackPanel>

                <StackPanel Spacing="8">
                    <Button Classes="secondary" HorizontalAlignment="Stretch" Content="{Binding RefreshLabel}" Command="{Binding RefreshCommand}" />
                    <UniformGrid Rows="1" ColumnSpacing="8">
                        <Button Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Command="{Binding ExportPngCommand}">
                            <TextBlock Text="{Binding ExportLabel}" Foreground="{DynamicResource DiscOnAccentBrush}" />
                        </Button>
                        <Button Classes="secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Content="{Binding CopyDiagnosticsLabel}"
                                Command="{Binding CopyDiagnosticsCommand}" />
                    </UniformGrid>
                    <TextBlock Text="{Binding ActionStatus}" Classes="settings-hint" TextWrapping="Wrap"
                               IsVisible="{Binding HasActionStatus}" />
                </StackPanel>

                <StackPanel Spacing="6" IsVisible="{Binding HasWarnings}">
                    <TextBlock Text="{Binding WarningsTitle}" Classes="settings-field-label" />
                    <Border Classes="settings-asset-summary missing">
                        <ItemsControl ItemsSource="{Binding Warnings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>

                <Expander Header="{Binding ParametersTitle}" HorizontalAlignment="Stretch">
                    <ItemsControl ItemsSource="{Binding Parameters}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="preview:PreviewParameterItem">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,2">
                                    <TextBlock Text="{Binding Name}" Classes="settings-hint" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="preview-parameter-value"
                                               TextTrimming="PrefixCharacterEllipsis" MaxWidth="170"
                                               ToolTip.Tip="{Binding Value}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
