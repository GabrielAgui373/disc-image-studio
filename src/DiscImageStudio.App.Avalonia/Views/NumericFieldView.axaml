<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fields="using:DiscImageStudio.App.Avalonia.ViewModels.Fields"
             x:Class="DiscImageStudio.App.Avalonia.Views.NumericFieldView"
             x:DataType="fields:NumericFieldViewModel">
    <StackPanel Spacing="4">
        <TextBlock Text="{Binding Label}" Classes="settings-field-label" />
        <TextBox x:Name="Input"
                 Classes="numeric-field"
                 Classes.invalid="{Binding HasError}"
                 Text="{Binding Text, Mode=TwoWay}"
                 AutomationProperties.Name="{Binding Label}">
            <TextBox.InnerRightContent>
                <TextBlock Text="{Binding Unit}" Classes="numeric-field-unit" />
            </TextBox.InnerRightContent>
        </TextBox>
        <TextBlock Text="{Binding Error}"
                   Classes="numeric-field-error"
                   TextWrapping="Wrap"
                   IsVisible="{Binding HasError}" />
    </StackPanel>
</UserControl>
