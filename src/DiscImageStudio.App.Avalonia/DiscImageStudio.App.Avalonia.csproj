<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>false</InvariantGlobalization>
    <AssemblyName>DiscImageStudio.App.Avalonia</AssemblyName>
    <RootNamespace>DiscImageStudio.App.Avalonia</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\avalonia-logo.ico</ApplicationIcon>
    <Title>Disc Image Studio</Title>
    <Product>Disc Image Studio</Product>
    <Description>Create image-mapped CD, DVD and Blu-ray artifacts on Linux.</Description>
    <Company>Disc Image Studio</Company>
    <Copyright>Copyright © 2026</Copyright>
    <AvaloniaVersion>12.1.4</AvaloniaVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
    <Watch Include="**\*.axaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../DiscImageStudio.Application/DiscImageStudio.Application.csproj" />
    <ProjectReference Include="../DiscImageStudio.Burning.Abstractions/DiscImageStudio.Burning.Abstractions.csproj" />
    <ProjectReference Include="../DiscImageStudio.Burning.Simulated/DiscImageStudio.Burning.Simulated.csproj" />
    <ProjectReference Include="../DiscImageStudio.Burning.Linux/DiscImageStudio.Burning.Linux.csproj" />
    <ProjectReference Include="../DiscImageStudio.Generation/DiscImageStudio.Generation.csproj" />
    <ProjectReference Include="../DiscImageStudio.Preview/DiscImageStudio.Preview.csproj" />
  </ItemGroup>
</Project>
